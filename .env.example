# ==============================================================================
# CẤU HÌNH KẾT NỐI GOOGLE GEMINI WEB (gemini.google.com/app)
# Hỗ trợ: Đơn tài khoản, Multi-Account Cookie Pool & Tự động Failover khi hết Quota
# ==============================================================================

# ------------------------------------------------------------------------------
# CÁCH 1: Cấu hình đơn tài khoản truyền thống (Primary Account)
# Lấy từ F12 -> Application/Storage -> Cookies -> https://gemini.google.com
# ------------------------------------------------------------------------------
GEMINI_ACCOUNT_NAME="Tài khoản Chính"
GEMINI_SECURE_1PSID=
GEMINI_SECURE_1PSIDTS=
GEMINI_SECURE_1PSIDCC=

# ------------------------------------------------------------------------------
# CÁCH 2: Cấu hình Multi-Account Cookie Pool (Tài khoản phụ dự phòng _1, _2, ... _N)
# Khi tài khoản chính hết Quota (HTTP 429) hoặc hết hạn cookie, hệ thống tự động
# failover tức thì sang tài khoản kế tiếp trong pool mà không làm gián đoạn tác vụ.
# ------------------------------------------------------------------------------
# Tài khoản dự phòng #1
GEMINI_ACCOUNT_NAME_1="Tài khoản Phụ 1"
GEMINI_SECURE_1PSID_1=
GEMINI_SECURE_1PSIDTS_1=
GEMINI_SECURE_1PSIDCC_1=

# Tài khoản dự phòng #2
GEMINI_ACCOUNT_NAME_2="Tài khoản Phụ 2"
GEMINI_SECURE_1PSID_2=
GEMINI_SECURE_1PSIDTS_2=
GEMINI_SECURE_1PSIDCC_2=

# ------------------------------------------------------------------------------
# CÁCH 3: Tự động trích xuất Cookie từ trình duyệt cục bộ
# Trình duyệt hỗ trợ: edge, chrome, firefox, brave, opera, vivaldi
# ------------------------------------------------------------------------------
GEMINI_AUTO_BROWSER_COOKIES=true
GEMINI_PREFERRED_BROWSER=edge
# Danh sách trình duyệt ưu tiên quét theo thứ tự (ngăn cách bởi dấu phẩy):
# GEMINI_BROWSER_SOURCES=edge,chrome,brave,firefox

# ------------------------------------------------------------------------------
# CHIẾN LƯỢC ĐIỀU PHỐI POOL (POOL STRATEGY & COOLDOWN)
# ------------------------------------------------------------------------------
# Chiến lược:
#   - active_first : Sử dụng tài khoản đầu tiên khả dụng, chỉ chuyển sang tài khoản khác khi gặp lỗi Quota/Auth (Khuyên dùng)
#   - round_robin  : Xoay vòng tài khoản đều qua từng request để phân phối tải
GEMINI_POOL_STRATEGY=active_first

# Thời gian làm nguội mặc định khi tài khoản chạm ngưỡng Quota / Rate Limit (tính bằng giây, mặc định: 1800s = 30 phút)
# Hệ thống sẽ tự động khôi phục tài khoản về ACTIVE sau khi hết thời gian này
GEMINI_RATE_LIMIT_COOLDOWN=1800

# ------------------------------------------------------------------------------
# CẤU HÌNH MODEL VÀ SUY LUẬN SÂU
# ------------------------------------------------------------------------------
# Model mặc định: gemini-4 (Gemini 4 Argon), gemini-pro, gemini-flash, gemini-flash-lite
GEMINI_DEFAULT_MODEL=gemini-4

# Chế độ suy luận sâu (Extended Thinking / High Reasoning): true (mặc định cho Gemini 4 High) hoặc false
GEMINI_EXTENDED_THINKING=true

# Proxy mạng (nếu cần thiết, ví dụ: http://127.0.0.1:7890)
GEMINI_PROXY=

# ------------------------------------------------------------------------------
# CẤU HÌNH OPENAI-COMPATIBLE PROXY SERVER (http://127.0.0.1:8000/v1)
# ------------------------------------------------------------------------------
PROXY_HOST=127.0.0.1
PROXY_PORT=8000
PROXY_API_KEY=sk-gemini-web-token
